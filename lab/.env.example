# URL advertised by the Pact Broker in generated links and pact URLs.
# Use the host IP for remote access, or set it to http://gitlab.local:9292
# if that name resolves for both this host and your remote client.
PACT_BROKER_PUBLIC_URL=http://192.168.1.39:9292

# URL used by the lab scripts to reach the broker.
PACT_BROKER_BASE_URL=http://192.168.1.39:9292
PACT_BROKER_USERNAME=pact
PACT_BROKER_PASSWORD=pact

# Hosts allowed in pact URLs received by the webhook receiver.
PACT_URL_HOST_ALLOWLIST=localhost,127.0.0.1,pact-broker,192.168.1.39,gitlab.local

CONSUMER_NAME=the-consumer
PROVIDER_NAME=the-provider
BRANCH=main
TARGET_ENV=test

WEBHOOK_SECRET=local-secret
WEBHOOK_RECEIVER_URL=http://192.168.1.39:7070

# The broker reaches the receiver over the Compose network.
WEBHOOK_RECEIVER_INTERNAL_URL=http://webhook-receiver:7070/webhooks/pact
